{
  "name": "@verdent/auth-js",
  "version": "0.1.9",
  "private": false,
  "description": "Verdent-managed Supabase Auth SDK and built-in browser UI.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codeck-frontend/auth-js.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "peerDependencies": {
    "@supabase/supabase-js": ">=2 <3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://npm.verdent.app/"
  },
  "scripts": {
    "build": "rimraf dist tsconfig.tsbuildinfo && tsc -p tsconfig.build.json",
    "dev": "vite --host 127.0.0.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.110.6",
    "@types/node": "^24.0.0",
    "jsdom": "^26.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
