# ============================================================
# ШАБЛОН. Скопіюйте в .env і заповніть РЕАЛЬНИМИ значеннями.
# .env у git НЕ комітиться (worker/.gitignore). Генерація секретів:
#   openssl rand -hex 32
# ============================================================

# --- Домени (DNS: A-записи обох на IP вашого VPS) ---
WORKER_HOST=worker.example.ua
GO_HOST=go.example.ua

# --- Загальний API-ключ воркера (Bearer) ---
# Той самий вводиться в Адмінці консолі → КОНЕКТОР: Воркер сесій
API_KEY=CHANGE_ME_openssl_rand_hex_32

# --- Сіль для хешування IP/UA в gateway (НЕ секрет авторизації, але приватна) ---
CLICK_HASH_SALT=CHANGE_ME_openssl_rand_hex_32

# --- Шифрування сесій Telegram на диску (AES-256-GCM, 32 байти hex) ---
SESSION_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# --- Telegram API (my.telegram.org → API development tools) ---
TG_API_ID=123456
TG_API_HASH=CHANGE_ME_32_hex_from_my.telegram.org
