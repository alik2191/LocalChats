{
	# Let's Encrypt за замовчуванням; email для CA-нотифікацій можна додати тут
}

{$WORKER_HOST} {
	# Консоль ходить на воркер з іншого origin (app.*.verdent.app) — потрібен CORS
	header {
		Access-Control-Allow-Origin "{$CONSOLE_ORIGIN}"
		Access-Control-Allow-Headers "Authorization, Content-Type, apikey"
		Access-Control-Allow-Methods "GET, POST, OPTIONS"
	}
	@preflight method OPTIONS
	respond @preflight 204

	# Telegram (gramjs-мікросервіс) — маршрут до /tg/* пріоритетніший
	handle /tg/* {
		reverse_proxy tg-worker:8787
	}
	# Evolution API (WhatsApp-сесії) — усе інше
	handle {
		reverse_proxy evolution:8080
	}
}

{$GO_HOST} {
	# Deep-link редирект + запис кліків (gateway); CORS тут не потрібен — це 302 для браузера клієнта
	reverse_proxy gateway:8788
}
